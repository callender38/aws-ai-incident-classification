digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.45"];
  node [shape=box, style="rounded,filled", fillcolor="#F7F7F7", color="#555555", fontname="Arial", fontsize=10, margin="0.12,0.08"];
  edge [color="#555555", arrowsize=0.7, fontname="Arial", fontsize=9];

  cw [label="Amazon CloudWatch\nAlarm / Incident"];
  eb [label="Amazon EventBridge\nAlarm State Rule"];
  sf [label="AWS Step Functions\nIncident Workflow"];
  lam [label="AWS Lambda Container\nTF-IDF + Logistic Regression\nCategory and Severity"];
  choice [shape=diamond, label="P1 or low\nconfidence?", fillcolor="#FFFFFF"];
  sns1 [label="Amazon SNS\nHuman Review / On-call"];
  sns2 [label="Amazon SNS\nRoute to Resolver Team"];
  ddb [label="DynamoDB / CloudWatch Logs\nDecision, latency, audit metrics"];

  cw -> eb -> sf -> lam -> choice;
  choice -> sns1 [label="Yes"];
  choice -> sns2 [label="No"];
  lam -> ddb [label="record result"];
  sns1 -> ddb [style=dashed];
  sns2 -> ddb [style=dashed];
}
